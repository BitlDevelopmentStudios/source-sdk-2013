$modelname "weapons/c_superphyscannon.mdl"

$bodygroup "studio"
{
	studio "c_superphyscannon_SuperPhyscannon_ref.smd"
}


$surfaceprop "default"

$contents "solid"

$illumposition 0 0 0

$cdmaterials "models\weapons\v_physcannon\"

